{
  "name": "inbucket-startos",
  "scripts": {
    "build": "npm run build:startos && npm run build:frontend",
    "build:startos": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "build:frontend": "vite build",
    "build:frontend:watch": "vite build --watch",
    "prettier": "prettier --write startos",
    "check": "npm run check:startos && npm run check:frontend",
    "check:startos": "tsc --noEmit",
    "check:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "test:frontend": "vitest run",
    "test": "npm run test:frontend"
  },
  "dependencies": {
    "@start9labs/start-sdk": "2.0.9",
    "lettersanitizer": "^1.0.8",
    "linkify-element": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "@start9labs/start-sdk": "$@start9labs/start-sdk"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vercel/ncc": "^0.38.4",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^26.1.0",
    "msw": "2.15.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  }
}
